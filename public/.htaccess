# ──────────────────────────────────────────────────────────────
#  SPA routing for Apache
#
#  React Router handles /user/admin, /login, /verifier/dashboard etc.
#  in the browser — those paths do not exist as files on disk. Without
#  this file, refreshing or opening such a URL directly makes Apache
#  look for a real file and return 404 Not Found.
#
#  Rule: if the request is not an existing file or directory,
#  serve index.html and let React Router resolve the route.
# ──────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite the API (in case it is proxied under the same host)
    RewriteRule ^api/ - [L]

    # Real files and folders are served as-is (JS, CSS, images…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the SPA entry point
    RewriteRule ^ index.html [L]
</IfModule>

# Hashed asset filenames change on every build, so they can be cached hard.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html must never be cached, or users keep seeing the old build.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
