# ──────────────────────────────────────────────────────────────
#  SPA routing for Apache
#
#  React Router handles /user/admin, /login, /verifier/dashboard etc.
#  in the browser — those paths do not exist as files on disk. Without
#  this file, refreshing or opening such a URL directly makes Apache
#  look for a real file and return 404 Not Found.
#
#  Rule: if the request is not an existing file or directory,
#  serve index.html and let React Router resolve the route.
# ──────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Canonical host: www.acvr.edu.mm → acvr.edu.mm ──
    #
    #  Keeps one public URL for SEO and for the session/CORS setup. Runs
    #  BEFORE the SPA catch-all below, otherwise the request would be
    #  rewritten to index.html and never redirect.
    #
    #  NOTE: this only fires once a request actually reaches Apache with
    #  Host: www.acvr.edu.mm. It does not create DNS — if www has no A/CNAME
    #  record, the browser fails before any HTTP request is made.
    #
    #  REQUEST_URI is the path only; mod_rewrite re-appends the original
    #  query string on its own, so /login?x=1 survives the hop. 301 is cached
    #  by browsers for a long time — test with 302 first if unsure.
    RewriteCond %{HTTP_HOST} ^www\.acvr\.edu\.mm$ [NC]
    RewriteRule ^ https://acvr.edu.mm%{REQUEST_URI} [R=301,L]

    # Never rewrite the API (in case it is proxied under the same host)
    RewriteRule ^api/ - [L]

    # Real files and folders are served as-is (JS, CSS, images…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the SPA entry point
    RewriteRule ^ index.html [L]
</IfModule>

# Hashed asset filenames change on every build, so they can be cached hard.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html must never be cached, or users keep seeing the old build.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
